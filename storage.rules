// Firebase Storage rules for the BYD Showroom Kiosk.
// Paste into Firebase console → Storage → Rules, then Publish.
//
// - public/**        : anyone can read (the kiosk loads media by plain URL); no writes from the web.
// - everything else  : no access.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
