# Copy to `.env.local` (and add the same variable on Vercel).

# Firebase Storage bucket id – the bucket name without "gs://",
# e.g. your-project-id.firebasestorage.app (or your-project-id.appspot.com).
NEXT_PUBLIC_FIREBASE_BUCKET=your-project-id.firebasestorage.app

# Public address of the site (link previews, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://byd-microsite.vercel.app
